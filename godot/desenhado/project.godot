; Projeto Godot do estilo de textura "Desenhado" do Labirinto.
; Ferramenta: pinta as texturas por shader e exporta PNG. O app só lê as imagens.

config_version=5

[application]

config/name="Labirinto - Desenhado"
config/description="Protótipo do estilo de textura Desenhado: cena de mapa e exportador de texturas."
run/main_scene="res://cenas/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.169, 0.169, 0.169, 1)
