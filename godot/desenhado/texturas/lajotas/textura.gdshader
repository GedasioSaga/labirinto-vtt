// Lajotas de pedra, forma Clara: piso interno com estrutura. Lote 3 da onda 1.
// Pedra clara entre a pedra e a praça da paleta, assentada à mão em fiadas, com
// juntas largas e macias da cor da pedra escurecida. A geometria e a pintura moram em
// lajotas.gdshaderinc (a forma Escura inclui o mesmo arquivo: a mesma geometria, só o
// tom muda). Notas das rodadas no config.json não cabem: ficam no include.
shader_type canvas_item;
render_mode unshaded, blend_disabled;

#include "res://comum/cabecalho.gdshaderinc"
#include "res://texturas/lajotas/lajotas.gdshaderinc"
#include "res://comum/rodape.gdshaderinc"
