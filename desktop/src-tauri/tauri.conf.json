{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labirinto",
  "version": "0.3.0",
  "identifier": "com.labirinto.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=client",
    "beforeBuildCommand": "npm run build --workspace=client",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Labirinto",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
